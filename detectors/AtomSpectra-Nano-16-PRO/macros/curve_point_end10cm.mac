# Кривая эффективности: точечный источник на оси кристалла, 10 см от НАРУЖНОЙ
# поверхности передней крышки (торец 18 x 15 мм). Диапазон 40-3000 кэВ —
# задание оператора 05.08.2026. Схема согласована (nano16pro_setup_point10cm.png).
#
# Конус 35°, долю (1-cos t)/2 exe печатает в шапку каждого спектра
# (solid_angle_frac); разбор делит на неё.
#
# ВАЖНО: файл в UTF-8 БЕЗ BOM, иначе Geant4 не распознаёт первую команду и
# обрывает макрос, завершаясь с кодом 0 и без единого файла.
/run/initialize
/control/verbose 0
/run/verbose 0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0 0 131.6 mm
/gps/ang/type iso
/gps/ang/maxtheta 35 deg

/gps/energy 40 keV
/asn16/outFile spectra/end10cm_E0040.0.csv
/run/beamOn 10000000
/gps/energy 50 keV
/asn16/outFile spectra/end10cm_E0050.0.csv
