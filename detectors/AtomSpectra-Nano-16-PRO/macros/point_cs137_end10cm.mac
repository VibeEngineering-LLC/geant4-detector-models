# Опорный замер: точечный Cs-137 на оси кристалла, 10 см от НАРУЖНОЙ
# поверхности передней крышки. Схема согласована оператором 05.08.2026
# (drawings/nano16pro_setup_point10cm.png).
#
# z источника = 31,60 (наружный торец) + 100,00 = 131,60 мм.
# Ось x = y = 0 — ось КРИСТАЛЛА; ось корпуса ниже на 2,70 мм.
#
# Конус 35°: долю (1−cos θ)/2 печатает сам exe в шапку спектра
# (solid_angle_frac); при 35° это 0,09042391 — значение, округлённое UI Geant4
# до шести значащих цифр, и разыгрывается ровно оно. Разбор на эту долю
# УМНОЖАЕТ, а не делит: N квантов в конусе доли f эквивалентны N/f в 4pi,
# поэтому eps(4pi) = C*f/N. Прежде комментарий предписывал делить — это
# завысило бы результат в 1/f^2 = 122 раза.
# Запас намеренный: на плоскости торца конус даёт радиус 70 мм при 25,9 мм
# до самого дальнего угла корпуса, корпус целиком внутри конуса по всей длине.
/run/initialize
/control/verbose 0
/run/verbose 0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0 0 131.6 mm
/gps/ang/type iso
/gps/ang/maxtheta 35 deg
/gps/energy 661.657 keV
/asn16/outFile cs137_end10cm_quick.csv
/run/beamOn 2000000
