# Опорный замер: точечный Cs-137 на оси кристалла, 10 см от НАРУЖНОЙ
# поверхности передней крышки. Схема согласована оператором 05.08.2026
# (drawings/nano16pro_setup_point10cm.png).
#
# z источника = 31,60 (наружный торец) + 100,00 = 131,60 мм.
# Ось x = y = 0 — ось КРИСТАЛЛА; ось корпуса ниже на 2,70 мм.
#
# Конус 35°: доля (1−cos θ)/2 = 0,090416, её печатает сам exe в шапку спектра
# (solid_angle_frac) — делить на неё при переходе к полной точечной eps.
# Запас намеренный: на плоскости торца конус даёт радиус 70 мм против 25,9 мм
# до самого дальнего угла корпуса, корпус целиком внутри конуса по всей длине.
/run/initialize
/control/verbose 0
/run/verbose 0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0 0 131.6 mm
/gps/ang/type iso
/gps/ang/maxtheta 35 deg
/gps/energy 661.657 keV
/asn16/outFile cs137_end10cm_quick.csv
/run/beamOn 2000000
