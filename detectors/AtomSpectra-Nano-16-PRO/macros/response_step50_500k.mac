# ФУНКЦИЯ ПОЛНОГО ОТКЛИКА: та же сетка 30-3000 кэВ с шагом 50, 5e5 историй.
#
# Задание автора библиотеки BecqMoni: посчитать на этих же узлах функцию
# полного отклика, ориентир по времени — около пяти минут.
#
# Отклик отдельным прогоном НЕ считается: спектр энерговыделения пишется на
# каждом узле самим exe (гистограмма 3700 каналов по 1 кэВ), поэтому сетка
# моноэнергетических прогонов И ЕСТЬ матрица отклика. Сборка матрицы —
# analysis/response_matrix.py, доли секунды.
#
# Почему 5e5, а не 2e5, как в curve_step50_200k.mac. Для эффективности хватает
# отсчётов в пике, для отклика нужны отсчёты В КАЖДОМ канале континуума. При
# 2e5 на элемент разрешения приходилось 10-65 отсчётов, то есть 12-30 % шума
# на элемент. Пятикратный запас берётся ровно под названный бюджет времени.
#
# Постановка узел в узел повторяет curve_point_end10cm.mac; отличается только
# сетка и число первичных.
#
# ВАЖНО: файл в UTF-8 БЕЗ BOM.
/run/initialize
/control/verbose 0
/run/verbose 0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0 0 132.6 mm
/gps/ang/type iso
/gps/ang/maxtheta 35 deg
/gps/energy 30 keV
/asn16/outFile spectra_resp50/end10cm_E0030.0.csv
/run/beamOn 500000
/gps/energy 80 keV
