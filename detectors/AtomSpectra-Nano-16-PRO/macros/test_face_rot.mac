# Проверка поворота оси конуса для ориентации «рабочая грань».
#
# Конус GPS разыгрывается вокруг −Z системы координат углового распределения.
# Для источника НАД прибором конус нужен вокруг −Y, что задаётся rot1/rot2.
# При неверном повороте конус светит мимо: счёт падает на порядки, а прогон
# отрабатывает без единой жалобы — поэтому поворот проверяется, а не
# принимается на веру.
#
# Ожидание: eff_total того же порядка, что у торцевой ориентации (1,6e-2 при
# конусе 35°), с поправкой на площадь грани и другой конус.
/run/initialize
/control/verbose 0
/run/verbose 0
/gps/particle gamma
/gps/pos/type Point
/gps/pos/centre 0 109.8 0 mm
/gps/ang/type iso
/gps/ang/rot1 1 0 0
/gps/ang/rot2 0 0 -1
/gps/ang/maxtheta 45 deg
/gps/energy 661.657 keV
/asn16/outFile test_face_rot.csv
/run/beamOn 200000
