# ДИАГНОСТИКА: чувствительность отношения линий 583/2614 к толщине кристалла
# ПО ПУЧКУ.
#
# Повод. Измеренное отношение площадей Tl-208 583,19 / 2614,51 равно 7,84,
# модель при паспортных 15,00 мм даёт 3,63 — в 2,2 раза. Отношение не зависит
# ни от активности, ни от нормировки источника, значит ошибается ОТНОСИТЕЛЬНЫЙ
# отклик.
#
# Почему подозрение падает на толщину. В постановке с пачкой излучение входит
# через грань 18 x 60 мм и проходит cryY. Опорный замер Cs-137, которым модель
# проверена, просвечивал кристалл ВДОЛЬ оси Z на 60 мм — то есть размер 15 мм
# не проверялся никогда, а именно он задаёт, как быстро падает эффективность с
# ростом энергии: на 583 кэВ пробег в CsI 2,7 см, на 2614 — 5,5 см.
#
# ОБЛАСТЬ РОЗЫГРЫША ОБЯЗАНА ЕХАТЬ ВМЕСТЕ С ГЕОМЕТРИЕЙ. Начало координат —
# ЦЕНТР кристалла, корпус строится от его граней, поэтому при изменении cryY
# пачка опускается: ось стержней y = cryY/2 − 29,5. В первой редакции этого
# макроса центр розыгрыша стоял неподвижно на −22,00, и при cryY = 9 в окно
# попадала полоска 0,2 мм у верха стержня — разыгрывалась корка без
# самопоглощения, отношение линий вышло 7,25 и выглядело подтверждением
# гипотезы. Прогон при этом ЗАВИС (confine почти не находил точек внутри Rod) —
# отказ был виден, но только по времени счёта, а не по числам.
#
# Считается только Tl-208: обе линии его, и обе меряются в одном прогоне.
#
# ВАЖНО: файл в UTF-8 БЕЗ BOM.
/asn16/wt20 on
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/gps/particle ion
/gps/ion 81 208
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/halfx 23.43 mm
/gps/pos/halfy 1.60 mm
/gps/pos/halfz 87.5 mm
/gps/pos/confine Rod
/gps/ang/type iso

/asn16/cryY 15.0
/gps/pos/centre 0 -22.00 -10.40 mm
/asn16/outFile wt20_depth/Tl208_cryY15.0.csv
/run/beamOn 200000

/asn16/cryY 12.0
/gps/pos/centre 0 -23.50 -10.40 mm
/asn16/outFile wt20_depth/Tl208_cryY12.0.csv
/run/beamOn 200000

/asn16/cryY 9.0
/gps/pos/centre 0 -25.00 -10.40 mm
/asn16/outFile wt20_depth/Tl208_cryY09.0.csv
/run/beamOn 200000

/asn16/cryY 6.0
/gps/pos/centre 0 -26.50 -10.40 mm
/asn16/outFile wt20_depth/Tl208_cryY06.0.csv
/run/beamOn 200000

/asn16/cryY 18.0
/gps/pos/centre 0 -20.50 -10.40 mm
/asn16/outFile wt20_depth/Tl208_cryY18.0.csv
/run/beamOn 200000
