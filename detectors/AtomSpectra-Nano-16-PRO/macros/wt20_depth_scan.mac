# ДИАГНОСТИКА: чувствительность отношения линий 583/2614 к толщине кристалла
# ПО ПУЧКУ.
#
# Повод. Измеренное отношение площадей Tl-208 583,19 / 2614,51 равно 7,84,
# модель на тех же окнах даёт 3,51 — в 2,2 раза. Отношение не зависит ни от
# активности, ни от нормировки источника, значит ошибается ОТНОСИТЕЛЬНЫЙ отклик.
#
# Почему подозрение падает на толщину. В постановке с пачкой излучение входит
# через грань 18 x 60 мм и проходит cryY = 15 мм. Опорный замер Cs-137,
# которым модель проверена, просвечивал кристалл ВДОЛЬ оси Z на 60 мм — то есть
# размер 15 мм не проверялся никогда, а именно он задаёт, как быстро падает
# эффективность с ростом энергии: на 583 кэВ пробег в CsI 2,7 см, на 2614 —
# 5,5 см, и обрезание пути бьёт по жёсткой линии сильнее.
#
# Это ЗАМЕР ЧУВСТВИТЕЛЬНОСТИ, а не подгонка геометрии под данные: результат —
# ответ на вопрос «какой толщине отвечало бы измеренное отношение», и его надо
# сверять с прибором, а не подставлять в паспорт.
#
# Считается только Tl-208: обе линии его, и обе меряются в одном прогоне.
#
# ВАЖНО: файл в UTF-8 БЕЗ BOM.
/asn16/wt20 on
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/gps/particle ion
/gps/ion 81 208
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Para
/gps/pos/halfx 38.05 mm
/gps/pos/halfy 1.60 mm
/gps/pos/halfz 87.5 mm
/gps/pos/centre 0 -22.00 -10.40 mm
/gps/pos/confine Rod
/gps/ang/type iso

/asn16/cryY 15.0
/asn16/outFile wt20_depth/Tl208_cryY15.0.csv
/run/beamOn 200000

/asn16/cryY 12.0
/asn16/outFile wt20_depth/Tl208_cryY12.0.csv
/run/beamOn 200000

/asn16/cryY 9.0
/asn16/outFile wt20_depth/Tl208_cryY09.0.csv
/run/beamOn 200000

/asn16/cryY 6.0
/asn16/outFile wt20_depth/Tl208_cryY06.0.csv
/run/beamOn 200000

/asn16/cryY 18.0
/asn16/outFile wt20_depth/Tl208_cryY18.0.csv
/run/beamOn 200000
