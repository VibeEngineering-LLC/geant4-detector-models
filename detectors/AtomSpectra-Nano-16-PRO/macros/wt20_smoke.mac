# ДЫМ-ТЕСТ постановки «пачка WT-20 под прибором».
#
# Проверяется ТРИ вещи, каждая из которых уже давала тихий отказ в этом дереве:
#   1) пачка действительно построена (печатается масса и положение стержней);
#   2) розыгрыш /gps/pos/confine Rod попадает в стержни, а не в воздух;
#   3) ограничение ряда одним звеном работает — в файле <спектр>_emit.csv
#      выходы линий должны совпасть с библиотечными для ОДНОГО нуклида.
#
# Tl-208 взят потому, что его каскад известен и проверяется в одну строку:
# 2614,5 кэВ должен идти почти на каждый распад.
#
# ВАЖНО: файл в UTF-8 БЕЗ BOM.
/asn16/wt20 on
/run/initialize
/control/verbose 0
/run/verbose 0
# Порог «очень долгого распада»: без него звенья с периодом больше года
# (Th-232, Ra-228, Th-228) не распадаются вовсе, а прогон отрабатывает молча.
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+60 year
/gps/particle ion
/gps/ion 81 208
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Para
# Область розыгрыша ОБЯЗАНА накрывать стержни целиком. Числа печатает сама
# программа (ось стержней y и центр корпуса z) и дублирует
# analysis/draw_wt20_setup.py — в первой редакции здесь стояло y = −18,0 при
# фактической оси −18,50, и нижние 0,4 мм каждого стержня не разыгрывались
# вовсе: прогон при этом отрабатывал молча, потому что confine отбрасывает
# промахи, а не жалуется.
/gps/pos/halfx 23.43 mm
/gps/pos/halfy 1.60 mm
/gps/pos/halfz 87.5 mm
/gps/pos/centre 0 -22.00 -10.40 mm
/gps/pos/confine Rod
/gps/ang/type iso
/asn16/outFile wt20_smoke/Tl208.csv
/run/beamOn 2000
