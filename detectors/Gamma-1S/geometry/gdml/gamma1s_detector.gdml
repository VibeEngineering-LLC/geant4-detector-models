  <solids>
    <tube aunit="deg" deltaphi="360" lunit="mm" name="NaI" rmax="31.5" rmin="0" startphi="0" z="63"/>
    <tube aunit="deg" deltaphi="360" lunit="mm" name="MgO_side" rmax="35.15" rmin="31.5" startphi="0" z="63"/>
