    </volume>
    <volume name="Electronics">
      <materialref ref="Electronics"/>
      <solidref ref="Electronics"/>
    </volume>
    <volume name="World">
      <materialref ref="G4_AIR"/>
      <solidref ref="World"/>
      <physvol name="NaI">
        <volumeref ref="NaI"/>
      </physvol>
      <physvol name="MgO_side">
