    <tube aunit="deg" deltaphi="360" lunit="mm" name="PMT_vac" rmax="34" rmin="0" startphi="0" z="120"/>
    <tube aunit="deg" deltaphi="360" lunit="mm" name="Electronics" rmax="37.65" rmin="0" startphi="0" z="122"/>
    <box lunit="mm" name="World" x="800" y="800" z="1400"/>
