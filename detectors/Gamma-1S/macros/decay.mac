# Каскадное суммирование: полный распад Tl-208 и Bi-214 в пробе Маринелли 1 л.
#
# Смысл: в моноэнергетическом прогоне каждый квант приходит в кристалл один,
# суммироваться не с чем. В реальном распаде кванты каскада летят одновременно,
# и если два попали в кристалл, событие уходит из своего пика. Отношение
# эффективностей моно/распад и есть поправка на суммирование.
#
# Выход линии p_gamma НЕ берётся из справочника: программа считает сами
# испущенные кванты (файл *_emit.csv) той же базой PhotonEvaporation.
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/verbose 0

# Розыгрыш по всему объёму пробы — как в сетке моноэнергий
/gps/particle ion
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Cylinder
/gps/pos/centre 0 0 16 mm
/gps/pos/radius 73 mm
/gps/pos/halfz 45 mm
/gps/pos/confine Sample
/gps/ang/type iso

# --- Tl-208: линии 2614,5 / 583,2 / 510,7 / 860,6 / 277,4 кэВ ---------------
# Цепочку обрываем на A = 208: Tl-208 -> Pb-208 стабилен, дальше нечему идти.
/process/had/rdm/nucleusLimits 208 208 81 82
/gps/ion 81 208 0 0
/g1s/outFile decay_Tl208.csv
/run/beamOn 2000000

# --- Bi-214: линии 609,3 / 1120,3 / 1764,5 / 1238,1 / 934,1 / 1377,7 --------
# A = 214 пропускает Bi-214 -> Po-214 (альфа, 164 мкс, гамма практически нет);
# дочерний Pb-210 (A = 210) уже вне окна и не распадается.
/process/had/rdm/nucleusLimits 214 214 83 84
/gps/ion 83 214 0 0
/g1s/outFile decay_Bi214.csv
/run/beamOn 2000000
