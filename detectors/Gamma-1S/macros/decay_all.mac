# Все прогоны распада одним процессом: поправка на суммирование, контроль
# метода и выходы линий на распад родителя.
#
# ЛОВУШКА, которая тут решает всё: порог «очень долгого распада». По умолчанию
# он равен 1 году, и долгоживущее ПЕРВИЧНОЕ ядро просто убивается, не
# распавшись. Это касается K-40 (1,25e9 лет), Ra-226 (1600 лет) и звеньев ряда
# тория — Ra-228 (5,75 г), Th-228 (1,9 г). Поднимаем порог один раз на весь
# сеанс: на короткоживущие Tl-208, Bi-214, Cs-137 это никак не влияет.
#
# Статистика подобрана под нужную точность, а не «побольше»: поправка на
# суммирование нужна с точностью около процента, выход линии — доли процента.
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+30 ns

/gps/particle ion
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Cylinder
# Область розыгрыша объемлет пробу при ШТАТНОЙ глубине колодца 74 мм: проба
# лежит в z = -27..56,6, область даёт -29..61. Меняете глубину — пересчитайте
# габарит, иначе верх пробы просто не будет облучаться, и молча: confine
# лишние точки отбрасывает, но недостающих не создаёт. Формула —
# drivers/run_probe.py, функция sample_span().
/gps/pos/centre 0 0 16 mm
/gps/pos/radius 73 mm
/gps/pos/halfz 45 mm
/gps/pos/confine Sample
/gps/ang/type iso

# ==== КОНТРОЛЬ: нуклиды без каскада, поправка обязана выйти 1,00 ============
# Cs-137 -> Ba-137m -> 661,657 кэВ, один квант на распад.
/process/had/rdm/nucleusLimits 137 137 55 56
/gps/ion 55 137 0 0
/g1s/outFile decay_Cs137.csv
/run/beamOn 600000

# K-40: захват на Ar-40 даёт 1460,8; бета-ветвь на Ca-40 гамма не даёт.
/process/had/rdm/nucleusLimits 40 40 18 20
/gps/ion 19 40 0 0
/g1s/outFile decay_K40.csv
/run/beamOn 2000000

# ==== СУММИРОВАНИЕ: каскадные нуклиды =======================================
# Bi-214: 609,3 / 768,4 / 1120,3 / 1764,5. Обрыв перед Pb-210.
/process/had/rdm/nucleusLimits 214 214 83 84
/gps/ion 83 214 0 0
/g1s/outFile decay_Bi214.csv
/run/beamOn 600000

# Tl-208: 583,2 / 860,6 / 2614,5. Pb-208 стабилен.
/process/had/rdm/nucleusLimits 208 208 81 82
/gps/ion 81 208 0 0
/g1s/outFile decay_Tl208.csv
/run/beamOn 600000

# ==== ЦЕПОЧКИ: выход линии НА РАСПАД РОДИТЕЛЯ ================================
# Нужны потому, что паспортная активность источников комплекта и паспортная
# МИА заданы на Ra-226 и Th-232, а линии испускают дочерние Bi-214 и Tl-208.
# Гоняем ряд целиком — коэффициенты ветвления получаются сами.
/process/had/rdm/nucleusLimits 214 226 82 88
/gps/ion 88 226 0 0
/g1s/outFile chain_Ra226.csv
/run/beamOn 150000

/process/had/rdm/nucleusLimits 208 232 81 90
/gps/ion 90 232 0 0
/g1s/outFile chain_Th232.csv
/run/beamOn 150000
