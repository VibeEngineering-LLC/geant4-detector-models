# Отдельные прогоны каждого γ-испускающего звена ветви Th-232 в маринелли.
# Задача — разложить цепочечный шаблон на нуклидные вклады: сумма всех
# восьми файлов при равном N = A_родителя × t равна полному шаблону
# chain_Th232.csv (в вековом равновесии, каким и является 420-7-17 через
# 17 лет после аттестации).
#
# Ключ разделения: nucleusLimits в Geant4 ограничивает диапазон (A_min,A_max,
# Z_min,Z_max) распадающихся ядер. Задавая один нуклид на прогон, получаем
# ТОЛЬКО его собственный вклад — цепочка ниже не пойдёт, ничего к нему не
# примешается.
#
# Все прогоны — тот же розыгрыш по объёму пробы, что и в chain_Th232, чтобы
# самопоглощение и геометрия сосуда были идентичны.
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+30 ns

/gps/particle ion
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Cylinder
/gps/pos/centre 0 0 16 mm
/gps/pos/radius 90 mm
/gps/pos/halfz 60 mm
/gps/pos/confine Sample
/gps/ang/type iso

# ─── Th-232 (α, γ практически нет; для полноты) ─────────────────────────────
/process/had/rdm/nucleusLimits 232 232 90 90
/gps/ion 90 232 0 0
/g1s/outFile iso_Th232.csv
/run/beamOn 200000

# ─── Ac-228 (β⁻; γ 338/911/964/969 и т.д.) ─────────────────────────────────
/process/had/rdm/nucleusLimits 228 228 89 89
/gps/ion 89 228 0 0
/g1s/outFile iso_Ac228.csv
/run/beamOn 200000

# ─── Th-228 (α; γ малой интенсивности 84/216) ──────────────────────────────
/process/had/rdm/nucleusLimits 228 228 90 90
/gps/ion 90 228 0 0
/g1s/outFile iso_Th228.csv
/run/beamOn 200000

# ─── Ra-224 (α; γ 241 кэВ) ────────────────────────────────────────────────
/process/had/rdm/nucleusLimits 224 224 88 88
/gps/ion 88 224 0 0
/g1s/outFile iso_Ra224.csv
/run/beamOn 200000

# ─── Rn-220 (α; γ 549 малой интенсивности) ────────────────────────────────
/process/had/rdm/nucleusLimits 220 220 86 86
/gps/ion 86 220 0 0
/g1s/outFile iso_Rn220.csv
/run/beamOn 200000

# ─── Pb-212 (β⁻; γ 238,6 / 300,1 / 415 кэВ) ───────────────────────────────
/process/had/rdm/nucleusLimits 212 212 82 82
/gps/ion 82 212 0 0
/g1s/outFile iso_Pb212.csv
/run/beamOn 200000

# ─── Bi-212 (β⁻ 64 %, α 36 %; γ 727 / 785 / 1620) ─────────────────────────
/process/had/rdm/nucleusLimits 212 212 83 83
/gps/ion 83 212 0 0
/g1s/outFile iso_Bi212.csv
/run/beamOn 200000

# ─── Tl-208 (β⁻; γ 2614,5 / 583 / 860 / 510 / 277) ────────────────────────
/process/had/rdm/nucleusLimits 208 208 81 81
/gps/ion 81 208 0 0
/g1s/outFile iso_Tl208.csv
/run/beamOn 200000
