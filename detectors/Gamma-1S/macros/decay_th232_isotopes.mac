# Отдельные прогоны каждого γ-испускающего звена ветви распада источника th232.
# СГЕНЕРИРОВАНО: tools/generate_isotope_macro.py из web-th232/configs/th232.yaml (geant4.isotope_runs).
# Руками не редактировать -- правки потеряются при следующей генерации; менять n_events/состав в конфиге.
#
# Ключ разделения: nucleusLimits в Geant4 ограничивает диапазон (A_min,A_max,
# Z_min,Z_max) распадающихся ядер. Задавая один нуклид на прогон, получаем
# ТОЛЬКО его собственный вклад -- цепочка ниже не пойдёт, ничего к нему не
# примешается. n_events выбран по каждому звену отдельно (не «побольше
# всем») -- слабая гамма-ветвь требует на порядки больше распадов на тот же
# отсчёт в кристалле (см. комментарий в конфиге, R66).
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+30 ns

/gps/particle ion
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Cylinder
/gps/pos/centre 0 0 16 mm
/gps/pos/radius 90 mm
/gps/pos/halfz 60 mm
/gps/pos/confine Sample
/gps/ang/type iso

# --- Th232 (Z=90, A=232) ---
/process/had/rdm/nucleusLimits 232 232 90 90
/gps/ion 90 232 0 0
/g1s/outFile iso_Th232.csv
/run/beamOn 3000000

# --- Ac228 (Z=89, A=228) ---
/process/had/rdm/nucleusLimits 228 228 89 89
/gps/ion 89 228 0 0
/g1s/outFile iso_Ac228.csv
/run/beamOn 200000

# --- Th228 (Z=90, A=228) ---
/process/had/rdm/nucleusLimits 228 228 90 90
/gps/ion 90 228 0 0
/g1s/outFile iso_Th228.csv
/run/beamOn 2000000

# --- Ra224 (Z=88, A=224) ---
/process/had/rdm/nucleusLimits 224 224 88 88
/gps/ion 88 224 0 0
/g1s/outFile iso_Ra224.csv
/run/beamOn 1000000

# --- Rn220 (Z=86, A=220) ---
/process/had/rdm/nucleusLimits 220 220 86 86
/gps/ion 86 220 0 0
/g1s/outFile iso_Rn220.csv
/run/beamOn 3000000

# --- Pb212 (Z=82, A=212) ---
/process/had/rdm/nucleusLimits 212 212 82 82
/gps/ion 82 212 0 0
/g1s/outFile iso_Pb212.csv
/run/beamOn 200000

# --- Bi212 (Z=83, A=212) ---
/process/had/rdm/nucleusLimits 212 212 83 83
/gps/ion 83 212 0 0
/g1s/outFile iso_Bi212.csv
/run/beamOn 2000000

# --- Tl208 (Z=81, A=208) ---
/process/had/rdm/nucleusLimits 208 208 81 81
/gps/ion 81 208 0 0
/g1s/outFile iso_Tl208.csv
/run/beamOn 200000
