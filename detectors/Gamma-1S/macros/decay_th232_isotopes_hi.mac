# Добор статистики по слабым звеньям ветви Th-232 (R66).
#
# Повод: сторож статистики показал, у каких шаблонов доля нуклида в канале
# определяется не физикой, а пуассоновским шумом самого шаблона. При 200 000
# распадов на звено (decay_th232_isotopes.mac) ниже порога 4 отсчёта МК на
# канал лежит: Th-232 — 100 % интеграла слоя, Rn-220 — 100 %, Th-228 — 43 %,
# Bi-212 — 23 %, Ra-224 — 6 %. У Ac-228, Pb-212 и Tl-208 — 2,7 / 0,3 / 0,5 %,
# они здесь не перегоняются: их статистика уже достаточна.
#
# Число розыгрышей у каждого звена своё и выбрано по его дефициту, а не
# «побольше всем»: слабая гамма-ветвь (Th-232 — 63,8 кэВ с выходом 0,26 %,
# Rn-220 — 549,7 кэВ с выходом 0,11 %) требует на два порядка больше распадов
# на тот же отсчёт в кристалле.
#
# Файлы те же, что у основного макроса: шаблоны заменяются целиком, разные
# N у разных звеньев расхождения не дают — каждый шаблон нормируется на своё
# число распадов отдельно (export_data.py, by_nuc_raw).
#
# ЗАПУСКАТЬ РОВНО ТАК — теми же аргументами, что и rerun_th232_R61.mac,
# которым получены остальные шаблоны:
#     g1s.exe decay_th232_isotopes_hi.mac vessel 1.6 OISN16
# Режим задаёт наличие тома Sample, третий аргумент — плотность пробы
# (1,6 г/см³), четвёртый — состав матрицы. Пропустить два последних значит
# посчитать самопоглощение в другом веществе: шаблоны станут несравнимы с
# остальными, причём молча — сторож режима такое не ловит.
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+30 ns

/gps/particle ion
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Cylinder
# Область розыгрыша обязана объемлеть пробу ЦЕЛИКОМ (R75): confine лишние
# точки отбрасывает, но недостающих не создаёт. Габарит снят с построенной
# геометрии (drivers/gps_region.py), сторож в модели роняет прогон, если
# тело розыгрыша не покрывает том.
/gps/pos/centre 0 0 16 mm
/gps/pos/radius 90 mm
/gps/pos/halfz 60 mm
/gps/pos/confine Sample
/gps/ang/type iso

# ─── Th-232 (α; единственная γ 63,8 кэВ, выход 0,26 %) ──────────────────────
/process/had/rdm/nucleusLimits 232 232 90 90
/gps/ion 90 232 0 0
/g1s/outFile iso_Th232.csv
/run/beamOn 3000000

# ─── Rn-220 (α; γ 549,7 кэВ, выход 0,11 %) ─────────────────────────────────
/process/had/rdm/nucleusLimits 220 220 86 86
/gps/ion 86 220 0 0
/g1s/outFile iso_Rn220.csv
/run/beamOn 3000000

# ─── Th-228 (α; γ 84,4 / 216 кэВ малой интенсивности) ──────────────────────
/process/had/rdm/nucleusLimits 228 228 90 90
/gps/ion 90 228 0 0
/g1s/outFile iso_Th228.csv
/run/beamOn 2000000

# ─── Bi-212 (β⁻ 64 %, α 36 %; γ 727 / 785 / 1620) ─────────────────────────
/process/had/rdm/nucleusLimits 212 212 83 83
/gps/ion 83 212 0 0
/g1s/outFile iso_Bi212.csv
/run/beamOn 2000000

# ─── Ra-224 (α; γ 241 кэВ) ────────────────────────────────────────────────
/process/had/rdm/nucleusLimits 224 224 88 88
/gps/ion 88 224 0 0
/g1s/outFile iso_Ra224.csv
/run/beamOn 1000000
