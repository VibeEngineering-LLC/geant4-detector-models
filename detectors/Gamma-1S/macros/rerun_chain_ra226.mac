# Пересчёт chain_Ra226.csv ТЕКУЩИМ exe (10.08.2026) -- старый файл не нёс
# поля src_in_crystal в шапке (сторож load_hist() в export_data.py отказал:
# "файл посчитан сборкой без сторожа 'источник в детекторе'"). Блок --
# дословная копия decay_all.mac (канонический прогон, 150 000 событий),
# изолирован от остальных пяти блоков файла (Cs137/K40/Bi214/Tl208/Th232),
# которые Ra-226 методу 1 не нужны и заняли бы время впустую.
/run/initialize
/control/verbose 0
/run/verbose 0
/process/had/rdm/verbose 0
/process/had/rdm/thresholdForVeryLongDecayTime 1.0e+30 ns

/gps/particle ion
/gps/energy 0 keV
/gps/pos/type Volume
/gps/pos/shape Cylinder
/gps/pos/centre 0 0 16 mm
/gps/pos/radius 90 mm
/gps/pos/halfz 60 mm
/gps/pos/confine Sample
/gps/ang/type iso

# Ряд Ra-226 -> ... -> Po-214, обрыв перед Pb-210 (см. decay_all.mac).
/process/had/rdm/nucleusLimits 214 226 82 88
/gps/ion 88 226 0 0
/g1s/outFile chain_Ra226.csv
/run/beamOn 150000
