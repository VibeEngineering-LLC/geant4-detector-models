;Очистка разметки пиков в спектре
clear
;Поиск пиков (чувствительность по умолчанию)
search()
;Установка окна идентификации (=кэВ)
$idwin=20
;Калибровка по энергии (степень калибровки,тип калибровки - "0" - использовать в качестве эталонных данных - библиотеку,путь к файлу библиотеки,путь в файлу для сохранения калибровки, "1" - флаг установки спектра как калибровочного) 
encalibr(2,0,C:\Lsrm\Work\Гамма-1С_\Data\Библиотека радионуклидов\Библиотека калибровочная.lib,C:\Lsrm\Work\Гамма-1С_\Data\Calibr.cen,1)
;Восстановление начальных параметров конфигурации (окна идентификации)
reset(idwin)
;Сохранение в конфигурации файла калибровки по энергии
$energyfile=C:\Lsrm\Work\Гамма-1С_\Data\Calibr.cen
;Очистка разметки пиков в спектре
clear
;Поиск пиков и подгонка (чувствительность из конфигурации)
searchandfit()
;Показать окно информации о пиках
showwindow(peakinfo)
