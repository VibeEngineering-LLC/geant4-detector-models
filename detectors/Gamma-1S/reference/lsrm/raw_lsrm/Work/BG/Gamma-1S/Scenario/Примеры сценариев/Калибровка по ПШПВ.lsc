;Очистка разметки пиков в спектре
clear
;Поиск пиков (чувствительность поиска = 20)
search(20)
;Калибровка по полуширине (степень калибровки,путь в файлу для сохранения калибровки, "1" - флаг установки спектра как калибровочного) 
fwcalibr(3,C:\Lsrm\Work\Гамма-1С №SRC-A25\Data\calibr.cfw,1)
;Восстановление начальных параметров конфигурации (чувствительности поиска)
reset(search)
;Сохранение в конфигурации файла калибровки по полуширине
$fwhmfile=C:\Lsrm\Work\Гамма-1С №SRC-A25\Data\calibr.cfw
;Очистка разметки пиков в спектре
clear
;Поиск пиков и подгонка (чувствительность из конфигурации)
searchandfit()
;Показать окно информации о пиках
showwindow(peakinfo)
