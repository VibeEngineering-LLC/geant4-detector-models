# Абсолютная эффективность на УЗКОМ пучке точно в грань кристалла.
# Смысл: полная эффективность такого пучка обязана равняться
# 1 - exp(-mu*L) по сечениям NIST XCOM (mu для CsI, L = 10 мм) —
# величина, считаемая независимо от Geant4. Расхождение = дефект модели.
# Пучок 4x4 мм по центру грани, чтобы края куба и корпус не размывали путь.
# Направление -Y -> +Y: со стороны дисплея, кристалл в 8,20 мм от грани.
# Запуск:  rc_curves abs_eff.mac bare
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/run/printProgress 0

/gps/particle gamma
/gps/ene/type Mono
/gps/pos/type Plane
/gps/pos/shape Square
/gps/pos/halfx 2 mm
/gps/pos/halfy 2 mm
/gps/pos/rot1 1 0 0
/gps/pos/rot2 0 0 1
/gps/pos/centre 0 -60 0 mm
/gps/direction 0 1 0

/gps/ene/mono 0.0595 MeV
/rc/outFile abs_eff_0060.csv
/run/beamOn 2000000

/gps/ene/mono 0.662 MeV
/rc/outFile abs_eff_0662.csv
/run/beamOn 2000000

/gps/ene/mono 1.4608 MeV
/rc/outFile abs_eff_1461.csv
/run/beamOn 2000000
