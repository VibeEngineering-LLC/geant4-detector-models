# #SHIELD-16: паспортная чувствительность в ИЗОТРОПНОМ поле, а не узким пучком.
#
# Зачем. Паспорт «30 cps = 1 мкЗв/ч по Cs-137» нормирован на H*(10), а H*(10)
# определён для РАСШИРЕННОГО И ВЫРОВНЕННОГО поля, не для узкого пучка по трём
# осям (sens_cs137.mac). Для выпуклого тела в изотропном поле средняя
# проекционная площадь = S/4, у куба 10 мм это 1.5 см² против 1.0 см² при
# нормальном падении — разница в 1.5 раза, того же порядка, что наблюдаемое
# расхождение 0.774.
#
# Как. Источник — сфера радиуса 200 мм, охватывающая прибор, испускание ВНУТРЬ
# с косинусным угловым распределением: это стандартный способ получить
# однородное изотропное поле внутри сферы. Флюенс на любой выпуклой поверхности
# внутри такого поля равен N/(pi*R^2) — тождество Коши, та же формула Ф=4N/S,
# что уже используется в run_bg_shield.py.
#
# Запуск:  rc_curves sens_iso.mac bare
/run/verbose 0
/event/verbose 0
/tracking/verbose 0
/run/printProgress 0

/gps/particle gamma
/gps/ene/type Mono
/gps/ene/mono 0.662 MeV

/gps/pos/type Surface
/gps/pos/shape Sphere
/gps/pos/centre 0 0 0 mm
/gps/pos/radius 200 mm

# испускание внутрь сферы, косинусный закон по нормали
/gps/ang/type cos
/gps/ang/mintheta 90 deg
/gps/ang/maxtheta 180 deg

/rc/outFile sens_iso.csv
/run/beamOn 3000000
